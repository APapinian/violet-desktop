configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "△";
    font: "Rubik 12";
}
* {
    bg: #17151f;
    surface: #251f32;
    fg: #ece4f8;
    accent: #c5b4ff;
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 780px;
    border: 1px;
    border-color: #8c77b3;
    border-radius: 24px;
    background-color: @bg;
    padding: 26px;
}
mainbox { spacing: 20px; children: [ textbox, inputbar, listview ]; }
textbox { str: "HYRULE  /  UYGULAMALAR"; font: "Rubik 11"; text-color: @accent; }
inputbar { background-color: @surface; border: 1px; border-color: #463c57; border-radius: 14px; padding: 16px; spacing: 12px; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry { placeholder: "Bir uygulama ara…"; }
listview { lines: 5; columns: 2; spacing: 8px; scrollbar: false; }
element { padding: 16px; border-radius: 12px; spacing: 12px; background-color: @surface; }
element selected { background-color: #46385d; border: 1px; border-color: @accent; }
element-icon { size: 28px; }
element-text { vertical-align: 0.5; }
