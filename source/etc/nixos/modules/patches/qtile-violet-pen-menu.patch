+/* Opt-in reserved side button. Only a private local compositor request is sent;
+ * no input device grabbing, uinput injection or client-directed synthetic keys. */
+static bool violet_pen_action(bool secondary) {
+    const char *runtime = getenv("XDG_RUNTIME_DIR");
+    if (!runtime || runtime[0] != '/') return false;
+    struct sockaddr_un addr = {.sun_family = AF_UNIX};
+    int length = snprintf(addr.sun_path, sizeof(addr.sun_path), "%s/violet-desktop/qtile.sock", runtime);
+    if (length < 0 || (size_t)length >= sizeof(addr.sun_path)) return false;
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (fd < 0) return false;
+    bool ok = false;
+    if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) == 0) {
+        const char *payload = secondary ? "{\"action\":\"pen-secondary\"}\n" : "{\"action\":\"pen-menu\"}\n";
+        ok = send(fd, payload, strlen(payload), MSG_NOSIGNAL) == (ssize_t)(strlen(payload));
+    }
+    close(fd);
+    return ok;
+}
