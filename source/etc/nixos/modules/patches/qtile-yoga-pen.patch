+        .pointer = &pointer,
+        .time_msec = time,
+        .button = button,
+        .state = pressed ? WL_POINTER_BUTTON_STATE_PRESSED : WL_POINTER_BUTTON_STATE_RELEASED,
+    };
+    qw_cursor_handle_button(&cursor->button, &event);
+    wlr_seat_pointer_notify_frame(cursor->server->seat);
+}
