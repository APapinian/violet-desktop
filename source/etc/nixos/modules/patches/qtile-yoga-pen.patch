+void qw_cursor_yoga_tablet_motion(struct qw_cursor *cursor, struct wlr_input_device *device,
+                                  uint32_t time, double x, double y) {
+    double lx, ly;
+    qw_server_idle_notify_activity(cursor->server);
+    wlr_cursor_absolute_to_layout_coords(cursor->cursor, device, x, y, &lx, &ly);
+    double dx = lx - cursor->cursor->x;
+    double dy = ly - cursor->cursor->y;
+    if (cursor->implicit_grab.live) {
+        wlr_cursor_move(cursor->cursor, device, dx, dy);
+        wlr_seat_pointer_notify_motion(cursor->server->seat, time,
+            cursor->cursor->x + cursor->implicit_grab.start_dx,
+            cursor->cursor->y + cursor->implicit_grab.start_dy);
+    } else {
+        qw_cursor_process_motion(cursor, time, device, dx, dy, dx, dy);
+    }
+    wlr_seat_pointer_notify_frame(cursor->server->seat);
+}
+
+void qw_cursor_yoga_tablet_button(struct qw_cursor *cursor, uint32_t time,
