# Procedural geometry is pre-rendered into 48 small frames; no video decoder.
Window.SetBackgroundTopColor(0.063, 0.059, 0.094);
Window.SetBackgroundBottomColor(0.094, 0.071, 0.145);
global.scale = Window.GetWidth() / 1920;
if (Window.GetHeight() / 1080 < global.scale)
  global.scale = Window.GetHeight() / 1080;
if (global.scale > 1.5) global.scale = 1.5;
global.size = Math.Int(620 * global.scale);
for (i = 0; i < 48; i++)
  global.frames[i] = Image("rune-" + i + ".png").Scale(global.size, global.size);
global.sigil = Sprite(global.frames[0]);
global.sigil.SetZ(10);
global.title_image = Image("title.png").Scale(Math.Int(560 * global.scale), Math.Int(70 * global.scale));
global.subtitle_image = Image("subtitle.png").Scale(Math.Int(560 * global.scale), Math.Int(42 * global.scale));
global.title = Sprite(global.title_image);
global.subtitle = Sprite(global.subtitle_image);
global.hint_image = Image("hint.png").Scale(Math.Int(560 * global.scale), Math.Int(32 * global.scale));
global.hint = Sprite(global.hint_image);
global.prompt_sprite = Sprite();
global.prompt_sprite.SetZ(100);
global.entry_sprite = Sprite();
global.entry_sprite.SetZ(100);
global.message_sprite = Sprite();
global.message_sprite.SetZ(100);
global.bar_image = Image("progress.png");
global.track = Sprite(Image("track.png").Scale(Math.Int(280 * global.scale), Math.Int(3 * global.scale)));
global.bar = Sprite(global.bar_image);
global.tick = 0;
global.progress = 0.02;
global.prompt_active = 0;

fun centered(sprite, image, y) {
  sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2);
  sprite.SetY(Window.GetY() + y);
}

fun refresh_callback() {
  global.tick++;
  frame = Math.Int(global.tick / 2) % 48;
  image = global.frames[frame];
  global.sigil.SetImage(image);
  centered(global.sigil, image, Window.GetHeight() * 0.43 - global.size / 2);
  fade = global.tick / 35;
  if (fade > 1) fade = 1;
  if (global.prompt_active) fade = 0.18;
  global.sigil.SetOpacity(fade);
  centered(global.title, global.title_image, Window.GetHeight() * 0.72);
  centered(global.subtitle, global.subtitle_image, Window.GetHeight() * 0.80);
  centered(global.hint, global.hint_image, Window.GetHeight() * 0.91);
  global.title.SetOpacity(fade);
  global.subtitle.SetOpacity(fade);
  global.track.SetX(Window.GetX() + Window.GetWidth() / 2 - 140 * global.scale);
  global.track.SetY(Window.GetY() + Window.GetHeight() * 0.87);
  global.bar.SetX(Window.GetX() + Window.GetWidth() / 2 - 140 * global.scale);
  global.bar.SetY(Window.GetY() + Window.GetHeight() * 0.87);
  global.track.SetOpacity(fade);
  global.bar.SetOpacity(fade);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  if (progress < 0.02) progress = 0.02;
  if (progress > 1) progress = 1;
  global.progress = progress;
  global.bar.SetImage(global.bar_image.Scale(Math.Int(280 * global.scale * progress), Math.Int(3 * global.scale)));
}
Plymouth.SetBootProgressFunction(progress_callback);
progress_callback(0, 0.02);

fun display_normal_callback() {
  global.prompt_active = 0;
  global.prompt_sprite.SetOpacity(0);
  global.entry_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun display_password_callback(prompt, bullets) {
  global.prompt_active = 1;
  image = Image.Text(prompt, 0.925, 0.894, 0.973);
  global.prompt_sprite.SetImage(image);
  centered(global.prompt_sprite, image, Window.GetHeight() * 0.52);
  global.prompt_sprite.SetOpacity(1);
  text = "";
  for (i = 0; i < bullets; i++) text += "●";
  image = Image.Text(text, 0.773, 0.706, 1.0);
  global.entry_sprite.SetImage(image);
  centered(global.entry_sprite, image, Window.GetHeight() * 0.59);
  global.entry_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt, entry_text) {
  display_password_callback(prompt, 0);
  image = Image.Text(entry_text, 0.773, 0.706, 1.0);
  global.entry_sprite.SetImage(image);
  centered(global.entry_sprite, image, Window.GetHeight() * 0.59);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_message_callback(text) {
  image = Image.Text(text, 0.925, 0.894, 0.973);
  global.message_sprite.SetImage(image);
  centered(global.message_sprite, image, Window.GetHeight() * 0.96);
  global.message_sprite.SetOpacity(1);
}
fun hide_message_callback(text) {
  global.message_sprite.SetOpacity(0);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
